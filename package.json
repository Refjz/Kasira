{
  "name": "kasira",
  "version": "0.1.0",
  "private": true,
  "description": "Kasvara POS: situs statis + Pages Functions, dan pembungkus Android (Capacitor)",
  "scripts": {
    "dev": "wrangler pages dev --port 8788",
    "db:init": "wrangler d1 execute kasira-db --remote --file schema.sql",
    "deploy": "wrangler pages deploy --project-name kasira --branch main --commit-dirty=true",
    "android:sync": "node scripts/android-web.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "wrangler": "^4.151.0"
  }
}
