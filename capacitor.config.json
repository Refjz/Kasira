{
  "appId": "com.kasira.pos",
  "appName": "Zidny POS",
  "webDir": "android-web",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0C7A62"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0C7A62",
      "showSpinner": false
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Mencari printer…",
        "cancel": "Batal",
        "availableDevices": "Printer tersedia",
        "noDeviceFound": "Printer tidak ditemukan"
      }
    }
  }
}
